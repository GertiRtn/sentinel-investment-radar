# Optional: otherwise authenticated account email identifies SEC requests.
SEC_CONTACT_EMAIL=
# Test only; never enable routinely in production.
SENTINEL_FORCE_FAIL=

# Optional Alpaca paper-account market-data credentials. Never commit real values.
ALPACA_DATA_KEY_ID=
ALPACA_DATA_SECRET=

# Research team (on-demand, per case). Off unless exactly "1". Reuses NVIDIA_API_KEY (Site secret).
RESEARCH_TEAM_ENABLED=
# Optional; must be on the allow-list in lib/sentinel/research-team.ts.
RESEARCH_MODEL=
